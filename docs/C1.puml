@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

' Layout tweak for a wider profile

Person(user_p, "System Participant", "End-user engaged in point-based loyalty activities.")
Person(staff_p, "Platform Operator", "Administrative staff managing ledger entries and corrections.")
Person(audit_p, "Compliance Auditor", "Internal/External stakeholder auditing system integrity.")

System(consolidate, "conSOLIDate App", "Core engine for point aggregation, balance tracking, and ledger history.")

System_Ext(auth_provider, "Identity Provider", "External OAuth2/OIDC service for user authentication.")

Rel(user_p, consolidate, "Views rewards and profile data")
Rel(staff_p, consolidate, "Adjusts balances and manages users")
Rel(audit_p, consolidate, "Extracts reports for auditing")

Rel_R(consolidate, auth_provider, "Validates sessions/tokens")
@enduml