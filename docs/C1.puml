@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(participant, "Participant", "User who signs up and tracks their points.")
Person(operator, "Operator", "Staff who manages points for participants.")
Person(viewer, "Viewer", "User who audits/views point balances.")

System(consolidate, "conSOLIDate App", "Allows management and tracking of user point balances.")

Rel(participant, consolidate, "Signs up, views own points")
Rel(operator, consolidate, "Adds/subtracts points")
Rel(viewer, consolidate, "Views any participant points")
@enduml
